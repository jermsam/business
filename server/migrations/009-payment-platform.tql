# Additive foundation only. Not applied by existing migration/startup commands.
define
attribute pay_id, value string;
attribute pay_product, value string;
attribute pay_environment, value string @values("sandbox", "live");
attribute pay_active, value boolean;
attribute pay_revision, value string;
attribute pay_fingerprint, value string;
attribute pay_amount, value integer @range(1..);
attribute pay_currency, value string;
attribute pay_exponent, value integer @range(0..3);
attribute pay_reference, value string;
attribute pay_status, value string @values("requested", "processing", "checkout_ready", "paid");
attribute pay_session, value string;
attribute pay_checkout_url, value string;
attribute pay_created, value integer;
attribute pay_event_type, value string @values("payment.requested", "payment.paid");
attribute pay_delivery_status, value string @values("pending", "delivering", "delivered", "dead");
attribute pay_attempts, value integer @range(0..8);
attribute pay_due, value integer;
attribute pay_lease, value string;
attribute pay_body_hash, value string;
entity pay_sandbox_receipt, owns pay_id @key, owns pay_body_hash @card(1), owns pay_created @card(1);

entity pay_application, owns pay_id @key;
relation pay_grant,
 relates merchant @card(1), relates application @card(1),
 owns pay_id @key, owns pay_product @card(1), owns pay_environment @card(1),
 owns pay_active @card(1), owns pay_revision @card(1);
company plays pay_grant:merchant;
pay_application plays pay_grant:application;

entity pay_request,
 owns pay_id @key, owns pay_fingerprint @card(1), owns pay_amount @card(1),
 owns pay_currency @card(1), owns pay_exponent @card(1), owns pay_reference @card(1),
 owns pay_status @card(1), owns pay_created @card(1), owns pay_session, owns pay_checkout_url;
relation pay_request_owner, relates grant @card(1), relates request @card(1);
pay_grant plays pay_request_owner:grant;
pay_request plays pay_request_owner:request @card(1);

entity pay_event, owns pay_id @key, owns pay_event_type @card(1), owns pay_created @card(1),
 owns pay_delivery_status @card(1), owns pay_attempts @card(1), owns pay_due @card(1), owns pay_lease @card(1);
relation pay_event_owner, relates request @card(1), relates event @card(1);
pay_request plays pay_event_owner:request;
pay_event plays pay_event_owner:event @card(1);

fun pay_authorized($a: pay_application, $m: company, $g: pay_grant, $product: string, $environment: string) -> boolean:
 match
 $g isa pay_grant, links (merchant:$m, application:$a),
  has pay_product $stored_product, has pay_environment $stored_environment, has pay_active true;
 $stored_product == $product; $stored_environment == $environment;
 return check;
