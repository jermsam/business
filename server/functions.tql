define

# TypeDB 3 replaces inferred TypeDB 2 relations with recursive functions.
fun ancestor_objects($child: object_) -> { object_ }:
  match
    { (parent: $parent, child: $child) isa contains; }
    or { (ancestor: $parent, descendant: $child) isa ancestor; }
    or { (parent: $middle, child: $child) isa contains;
         let $parent in ancestor_objects($middle); };
  return { $parent };

# Simple user check function
fun user_exists($email: string) -> boolean:
  match
    $u isa user, has email == $email;
  return check;

fun permission_active($p: permission, $now: datetime) -> boolean:
  match
    { not { $p has expires_at $absent_expiry; }; } or { $p has expires_at $e; $e > $now; };
  return check;

fun membership_active($m: membership, $now: datetime) -> boolean:
  match
    { not { $m has expires_at $absent_expiry; }; } or { $m has expires_at $e; $e > $now; };
  return check;

fun role_assignment_active($ra: role_assignment, $now: datetime) -> boolean:
  match
    { not { $ra has expires_at $absent_expiry; }; } or { $ra has expires_at $e; $e > $now; };
  return check;

fun tenant_role_assignment_active($tra: tenant_role_assignment, $now: datetime) -> boolean:
  match
    { not { $tra has expires_at $absent_expiry; }; } or { $tra has expires_at $e; $e > $now; };
  return check;

# Check if subject and object belong to same tenant
fun same_tenant($s: subject, $o: object_) -> boolean:
  match
    (tenant: $company, member: $s) isa tenant_membership;
    (tenant: $company, member: $o) isa tenant_membership;
    $company isa company;
  return check;

# Check for deny permissions (with group expansion)
fun has_deny($s: subject, $o: object_, $a: string, $now: datetime) -> boolean:
  match
    {
      $p isa permission, links (subject: $s, object: $o);
      $p has action $act;
      $act == $a;
      $p has effect $eff;
      $eff == "deny";
      let $p_ok_1 = permission_active($p, $now);
      $p_ok_1 == true;
    } or {
      $m isa membership, links (member: $s, group: $g1);
      $p2 isa permission, links (subject: $g1, object: $o);
      $p2 has action $act2;
      $act2 == $a;
      $p2 has effect $eff2;
      $eff2 == "deny";

      let $m_ok_2 = membership_active($m, $now);
      $m_ok_2 == true;
      let $p2_ok_3 = permission_active($p2, $now);
      $p2_ok_3 == true;
    } or {
      $ra isa role_assignment, links (subject: $s, object: $o, assigned_role: $r);
      let $ra_ok_4 = role_assignment_active($ra, $now);
      $ra_ok_4 == true;
      (granted_role: $r) isa role_permission,
        has action $act3,
        has effect $eff3;
      $act3 == $a;
      $eff3 == "deny";
    };
  return check;

# Check for allow permissions (with group expansion)
fun has_allow($s: subject, $o: object_, $a: string, $now: datetime) -> boolean:
  match
    {
      $p isa permission, links (subject: $s, object: $o);
      $p has action $act;
      $act == $a;
      $p has effect $eff;
      $eff == "allow";
      let $p_ok_5 = permission_active($p, $now);
      $p_ok_5 == true;
    } or {
      $m isa membership, links (member: $s, group: $g2);
      $p2 isa permission, links (subject: $g2, object: $o);
      $p2 has action $act2;
      $act2 == $a;
      $p2 has effect $eff2;
      $eff2 == "allow";
      let $m_ok_6 = membership_active($m, $now);
      $m_ok_6 == true;
      let $p2_ok_7 = permission_active($p2, $now);
      $p2_ok_7 == true;
    } or {
      $ra isa role_assignment, links (subject: $s, object: $o, assigned_role: $r2);
      let $ra_ok_8 = role_assignment_active($ra, $now);
      $ra_ok_8 == true;
      (granted_role: $r2) isa role_permission,
        has action $act3,
        has effect $eff3;
      $act3 == $a;
      $eff3 == "allow";
    };
  return check;

# Check for deny permissions with inheritance (object + parent)
fun has_deny_inherited($s: subject, $o: object_, $a: string, $now: datetime) -> boolean:
  match
    {
      # Direct deny on object
      $p isa permission, links (subject: $s, object: $o);
      $p has action $act;
      $act == $a;
      $p has effect $eff;
      $eff == "deny";
      let $p_ok_9 = permission_active($p, $now);
      $p_ok_9 == true;
    } or {
      # Group deny on object
      $m isa membership, links (member: $s, group: $g3);
      $p2 isa permission, links (subject: $g3, object: $o);
      $p2 has action $act2;
      $act2 == $a;
      $p2 has effect $eff2;
      $eff2 == "deny";
      let $m_ok_10 = membership_active($m, $now);
      $m_ok_10 == true;
      let $p2_ok_11 = permission_active($p2, $now);
      $p2_ok_11 == true;
    } or {
      # Role deny on object
      $ra isa role_assignment, links (subject: $s, object: $o, assigned_role: $r3);
      let $ra_ok_12 = role_assignment_active($ra, $now);
      $ra_ok_12 == true;
      (granted_role: $r3) isa role_permission,
        has action $act3,
        has effect $eff3;
      $act3 == $a;
      $eff3 == "deny";
    } or {
      # Inherited deny from any ancestor object
      let $parent1 in ancestor_objects($o);
      $parent1 isa object_;
      $p3 isa permission, links (subject: $s, object: $parent1);
      $p3 has action $act4;
      $act4 == $a;
      $p3 has effect $eff4;
      $eff4 == "deny";
      let $p3_ok_13 = permission_active($p3, $now);
      $p3_ok_13 == true;
    } or {
      # Inherited group deny from any ancestor object
      let $parent2 in ancestor_objects($o);
      $parent2 isa object_;
      $m2 isa membership, links (member: $s, group: $g4);
      $p4 isa permission, links (subject: $g4, object: $parent2);
      $p4 has action $act5;
      $act5 == $a;
      $p4 has effect $eff5;
      $eff5 == "deny";
      let $m2_ok_14 = membership_active($m2, $now);
      $m2_ok_14 == true;
      let $p4_ok_15 = permission_active($p4, $now);
      $p4_ok_15 == true;
    } or {
      # Inherited role deny from any ancestor object
      let $parent5 in ancestor_objects($o);
      $parent5 isa object_;
      $ra2 isa role_assignment, links (subject: $s, object: $parent5, assigned_role: $r5);
      let $ra2_ok_16 = role_assignment_active($ra2, $now);
      $ra2_ok_16 == true;
      (granted_role: $r5) isa role_permission,
        has action $act6,
        has effect $eff6;
      $act6 == $a;
      $eff6 == "deny";
    };
  return check;

# Check for allow permissions with inheritance (object + parent)
fun has_allow_inherited($s: subject, $o: object_, $a: string, $now: datetime) -> boolean:
  match
    {
      # Direct allow on object
      $p isa permission, links (subject: $s, object: $o);
      $p has action $act;
      $act == $a;
      $p has effect $eff;
      $eff == "allow";
      let $p_ok_17 = permission_active($p, $now);
      $p_ok_17 == true;
    } or {
      # Group allow on object
      $m isa membership, links (member: $s, group: $g5);
      $p2 isa permission, links (subject: $g5, object: $o);
      $p2 has action $act2;
      $act2 == $a;
      $p2 has effect $eff2;
      $eff2 == "allow";
      let $m_ok_18 = membership_active($m, $now);
      $m_ok_18 == true;
      let $p2_ok_19 = permission_active($p2, $now);
      $p2_ok_19 == true;
    } or {
      # Role allow on object
      $ra isa role_assignment, links (subject: $s, object: $o, assigned_role: $r4);
      let $ra_ok_20 = role_assignment_active($ra, $now);
      $ra_ok_20 == true;
      (granted_role: $r4) isa role_permission,
        has action $act3,
        has effect $eff3;
      $act3 == $a;
      $eff3 == "allow";
    } or {
      # Inherited allow from any ancestor object
      let $parent3 in ancestor_objects($o);
      $parent3 isa object_;
      $p3 isa permission, links (subject: $s, object: $parent3);
      $p3 has action $act4;
      $act4 == $a;
      $p3 has effect $eff4;
      $eff4 == "allow";
      let $p3_ok_21 = permission_active($p3, $now);
      $p3_ok_21 == true;
    } or {
      # Inherited group allow from any ancestor object
      let $parent4 in ancestor_objects($o);
      $parent4 isa object_;
      $m2 isa membership, links (member: $s, group: $g6);
      $p4 isa permission, links (subject: $g6, object: $parent4);
      $p4 has action $act5;
      $act5 == $a;
      $p4 has effect $eff5;
      $eff5 == "allow";
      let $m2_ok_22 = membership_active($m2, $now);
      $m2_ok_22 == true;
      let $p4_ok_23 = permission_active($p4, $now);
      $p4_ok_23 == true;
    } or {
      # Inherited role allow from any ancestor object
      let $parent6 in ancestor_objects($o);
      $parent6 isa object_;
      $ra2 isa role_assignment, links (subject: $s, object: $parent6, assigned_role: $r6);
      let $ra2_ok_24 = role_assignment_active($ra2, $now);
      $ra2_ok_24 == true;
      (granted_role: $r6) isa role_permission,
        has action $act6,
        has effect $eff6;
      $act6 == $a;
      $eff6 == "allow";
    };
  return check;

# Complete access control with tenant boundaries and inheritance
fun can_access_tenant_inherited($s: subject, $o: object_, $a: string, $now: datetime) -> boolean:
  match
    let $tenant_ok_25 = same_tenant($s, $o);
    let $has_allow_26 = has_allow_inherited($s, $o, $a, $now);
    let $has_deny_27 = has_deny_inherited($s, $o, $a, $now);

    $tenant_ok_25 == true;
    $has_allow_26 == true;
    $has_deny_27 == false;
  return check;

fun has_tenant_role_deny($s: subject, $c: company, $a: string, $now: datetime) -> boolean:
  match
    {
      $tra isa tenant_role_assignment, links (tenant: $c, subject: $s, assigned_role: $r);
      let $tra_ok_28 = tenant_role_assignment_active($tra, $now);
      $tra_ok_28 == true;

      (granted_role: $r) isa tenant_role_permission,
        has action $act,
        has effect $eff;
      $act == $a;
      $eff == "deny";
    } or {
      $m isa membership, links (member: $s, group: $g);
      let $m_ok_29 = membership_active($m, $now);
      $m_ok_29 == true;

      $tra isa tenant_role_assignment, links (tenant: $c, subject: $g, assigned_role: $r);
      let $tra_ok_30 = tenant_role_assignment_active($tra, $now);
      $tra_ok_30 == true;

      (granted_role: $r) isa tenant_role_permission,
        has action $act,
        has effect $eff;
      $act == $a;
      $eff == "deny";
    };
  return check;

fun has_tenant_role_allow($s: subject, $c: company, $a: string, $now: datetime) -> boolean:
  match
    {
      $tra isa tenant_role_assignment, links (tenant: $c, subject: $s, assigned_role: $r);
      let $tra_ok_31 = tenant_role_assignment_active($tra, $now);
      $tra_ok_31 == true;

      (granted_role: $r) isa tenant_role_permission,
        has action $act,
        has effect $eff;
      $act == $a;
      $eff == "allow";
    } or {
      $m isa membership, links (member: $s, group: $g);
      let $m_ok_32 = membership_active($m, $now);
      $m_ok_32 == true;

      $tra isa tenant_role_assignment, links (tenant: $c, subject: $g, assigned_role: $r);
      let $tra_ok_33 = tenant_role_assignment_active($tra, $now);
      $tra_ok_33 == true;

      (granted_role: $r) isa tenant_role_permission,
        has action $act,
        has effect $eff;
      $act == $a;
      $eff == "allow";
    };
  return check;

fun can_access_company($s: subject, $c: company, $a: string, $now: datetime) -> boolean:
  match
    (tenant: $c, member: $s) isa tenant_membership;
    let $has_allow_34 = has_tenant_role_allow($s, $c, $a, $now);
    let $has_deny_35 = has_tenant_role_deny($s, $c, $a, $now);

    $has_allow_34 == true;
    $has_deny_35 == false;
  return check;
