HTTP_HOST=127.0.0.1
HTTP_PORT=3030
TYPEDB_ADDR=https://your-cluster.cluster.typedb.com:80
TYPEDB_DB=business_native_dev
TYPEDB_USERNAME=business_dev_app
TYPEDB_PASSWORD=
TYPEDB_TLS=true
TYPEDB_FORCE_RECREATE=false
AUTH_JWT_SECRET=
BUSINESS_ACTIVE_REQUESTS=3
# Optional trusted gateway (>=32 bytes); API header: x-gateway-secret.
# BUSINESS_GATEWAY_SECRET=
# External secret JSON only. Omit these variables entirely if a provider is unused.
# STRIPE_CONNECTIONS_JSON=[{"tenant_id":"...","identity_ids":["..."],"environment":"test","token":"sk_test_...","write":false}]
# MERCURY_CONNECTIONS_JSON=[{"tenant_id":"...","identity_ids":["..."],"environment":"sandbox","token":"...","write":false}]
# Operator-only bootstrap fields; never pass these to the deployed server.
# BUSINESS_OWNER_EMAIL=
# BUSINESS_OWNER_NAME=
# BUSINESS_TENANT_NAME=
# BUSINESS_OWNER_PASSWORD=
