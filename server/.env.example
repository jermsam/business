HTTP_HOST=127.0.0.1
HTTP_PORT=3030
TYPEDB_ADDR=https://your-cluster.cluster.typedb.com:80
TYPEDB_DB=business_dev
TYPEDB_USERNAME=business_app
TYPEDB_PASSWORD=
TYPEDB_TLS=true
AUTH_JWT_SECRET=

# Per-process active request budget; keep the waiting queue bounded.
BUSINESS_ACTIVE_REQUESTS=3

# Billing remains opt-in and sandbox-only by default. No keys in Git.
BILLING_ENABLED=false
BILLING_LIVE=false
# UUID of the seller company: this account's provider keys cannot serve other merchants.
BILLING_MERCHANT_ID=
BILLING_PUBLIC_URL=https://your-business-host.example/billing
BILLING_TICK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCURY_SANDBOX_TOKEN=
MERCURY_SANDBOX_ACCOUNT_ID=
# Only set these after separate live-payment activation/validation.
MERCURY_API_TOKEN=
MERCURY_ACCOUNT_ID=
# Resend free-tier adapter, explicitly disabled until sender verification.
BILLING_MAIL_ENABLED=false
RESEND_API_KEY=
BILLING_EMAIL_FROM=
BILLING_TEST_EMAIL=
BILLING_REMINDER_DAYS=7
# Shared only with the Cloudflare portal. Set to a random value >=32 bytes when hosted.
# Once present, direct ordinary API requests must supply x-portal-secret.
# PORTAL_ORIGIN_SECRET=<random secret>
